# Build output — distributables are huge (100MB+ per AppImage) and regenerated every build
dist/
build/icons/
build/icon.png

# Dependencies — restore with `npm install`
node_modules/

# Generated before every build; re-runs during `npm start` / `npm run build:*`
renderer/version.json

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Per-release notes, staged for `gh release create --notes-file`
RELEASE_NOTES.md

# Env / secrets
.env
.env.local
